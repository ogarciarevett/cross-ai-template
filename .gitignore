# Local, per-developer agent working log — seeded from .ai/memory.example.md by `sh scripts/sync-ai-docs.sh`.
# Durable decisions go in commits / docs/adr, never here. See .ai/context.md "Memory protocol".
.ai/memory.md

# Secrets — never commit these.
.env
.env.*
!.env.example

# The template machinery is dependency-free (POSIX shell + awk/sed) — no runtime, no deps dir.
# /bootstrap appends your language's ignores (node_modules/, target/, __pycache__/, vendor/, …).

# Claude Code per-developer local settings (not shared).
.claude/settings.local.json

# OS / editor cruft
.DS_Store

# Demo recording tooling — kept local, not shipped. The rendered docs/imgs/demo.gif that the
# README embeds IS committed; the script and the intermediate asciinema cast are not.
scripts/record-demo.sh
docs/imgs/demo.cast
