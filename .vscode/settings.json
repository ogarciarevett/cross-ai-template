{
  // The per-tool agent mirrors (.claude/ .gemini/ .opencode/ .cursor/ .ai/generated/) are
  // GENERATED from .ai/ and gitignored — local-only, regenerated by `sh scripts/sync-ai-docs.sh`.
  // Hide gitignored files from the Explorer so the tree shows the single source of truth (.ai/)
  // instead of the generated copies. They still exist on disk; tools read them as normal.
  "explorer.excludeGitIgnore": true
}
