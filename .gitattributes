# GitHub Linguist hints — keep the repo's language bar honest.
#
# The per-tool configs are GENERATED from .ai/ by scripts/sync-ai-docs.sh. They are committed
# (so the pre-commit drift gate can diff them), but they are duplicates of the .ai/ sources.
# Mark them `linguist-generated` so they (a) don't inflate the language statistics with copies
# and (b) collapse by default in diffs/PRs. The language bar then reflects the SOURCE.
AGENTS.md            linguist-generated=true
CLAUDE.md            linguist-generated=true
GEMINI.md            linguist-generated=true
.ai/generated/**     linguist-generated=true
.claude/**           linguist-generated=true
.gemini/**           linguist-generated=true
.opencode/**         linguist-generated=true
.cursor/**           linguist-generated=true

# The dynamic Workflow scripts are a Claude-Code-only accelerant (the `Workflow` tool only
# accepts JavaScript), NOT part of the language-agnostic core. They stay in the repo as real,
# hand-edited source, but `linguist-vendored` keeps them out of the language bar so the repo's
# language profile reflects the portable machinery (Shell + Awk), not one tool's glue.
.ai/workflows/*.js   linguist-vendored=true
